# Release signing credentials for local release builds.
#
# Copy this file to `keystore.properties` (gitignored) and fill in the values to
# sign `:app:assembleRelease` locally. In CI the same values are supplied as the
# YAKUMO_* environment variables instead, so this file is not needed there.
#
# Create the keystore once with:
#   keytool -genkeypair -v -keystore yakumo.jks -alias yakumo \
#     -keyalg RSA -keysize 2048 -validity 10000
# Keep the .jks and these passwords safe and backed up: losing the key means you
# can no longer ship updates that an installed app will accept.

# Path to the keystore, relative to the android/ project root (or absolute).
storeFile=yakumo.jks
storePassword=CHANGEME
keyAlias=yakumo
keyPassword=CHANGEME
